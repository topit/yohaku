+			if at < sp.End {
+				var replacement []text.Span
+				if at > prev {
+					prefix := sp
+					prefix.End = at
+					replacement = append(replacement, prefix)
+				}
+				object := sp
+				object.End, object.ObjectWidth = at+1, inlays[seg.inlay].padding
+				replacement = append(replacement, object)
+				if at+1 < sp.End {
+					replacement = append(replacement, sp)
+				}
+				spans = slices.Replace(spans, i, i+1, replacement...)
+				break
+			}
+			prev = sp.End
+		}
+	}
+	if spans == nil {
+		return faces
+	}
+	return text.EncodeSpans(spans)
