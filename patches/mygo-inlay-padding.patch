+package editor_test
+
+import (
+	"math"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+	"github.com/egoist/mygo/ui/editor"
+)
+
+func TestInlayPaddingPreservesCaretCopyAndHitTargets(t *testing.T) {
+	for _, source := range []string{"12 + 3", "中文 12 + 3", "\t12 + 3"} {
+		st := &editor.State{Buffer: editor.NewBuffer(source), Label: "Padding editor", SoftWrap: true}
+		tt := ui.NewTester(func(c *ui.Context) { editor.View(c, st).Fill().AutoFocus() }, 700, 240)
+		st.Select(len(source), len(source))
+		tt.Frame()
+		before, _ := tt.TextCaret()
+		st.SetInlays([]editor.Inlay{{Offset: len(source), Text: "= 15", Padding: 100, CursorBefore: true}})
+		tt.Frame()
+		after, _ := tt.TextCaret()
+		if before != after {
+			t.Fatal("padding moved source caret", source, before, after)
+		}
+		area, found := tt.Find("Padding editor")
+		if !found {
+			t.Fatal("editor missing")
+		}
+		_, hit := st.HitTest(before.X+110-area.X, before.Y+before.H/2-area.Y)
+		if hit != len(source) {
+			t.Fatal("padded result not hit", source, hit)
+		}
+		st.SetInlays([]editor.Inlay{{Offset: len(source), Text: "= 15"}})
+		tt.Frame()
+		plain, _ := tt.TextCaret()
+		st.SetInlays([]editor.Inlay{{Offset: len(source), Text: "= 15", Padding: 100}})
+		tt.Frame()
+		padded, _ := tt.TextCaret()
+		if math.Abs(float64(padded.X-plain.X-100)) > .1 {
+			t.Fatal("padding is not an exact display width", source, plain, padded)
+		}
+		st.Select(0, len(source))
+		tt.Key(ui.Cmd, ui.KeyC)
+		if tt.Clipboard() != source {
+			t.Fatal("display spacer leaked into clipboard")
+		}
+		st.Select(len(source), len(source))
+		tt.Type("7")
+		st.Run(editor.Undo)
+		if st.Buffer.String() != source {
+			t.Fatal("display spacer changed undo history")
+		}
+		tt.SetSize(180, 240)
+		st.SetInlays([]editor.Inlay{{Offset: len(source), Text: "= 15"}})
+		tt.Frame()
+		plain, _ = tt.TextCaret()
+		st.SetInlays([]editor.Inlay{{Offset: len(source), Text: "= 15", Padding: 100000}})
+		tt.Frame()
+		padded, _ = tt.TextCaret()
+		if plain != padded {
+			t.Fatal("padding must not force an extra wrapped row", source, plain, padded)
+		}
+	}
+}
