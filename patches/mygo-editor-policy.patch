+// SetEditPolicy sets a policy for each batch of edits, including editor,
+// input-method and programmatic edits. The edits are normalized, nonoverlapping
+// UTF-8 ranges in before. Returning false rejects the entire batch before
+// text, version or undo history change. A nil policy accepts all edits.
+// The callback runs under the buffer lock: it must not call Buffer methods,
+// retain or modify edits, or block. Undo/redo replay previously accepted
+// transactions; Reset is a trusted document reload, not a policy-checked edit.
+func (b *Buffer) SetEditPolicy(policy func(before Snapshot, edits []Edit) bool) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.policy = policy
+}
+
+// TryEdit is Edit with an acceptance result, including accepted no-op edits.
+func (b *Buffer) TryEdit(edits ...Edit) bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	_, accepted := b.edit(edits, editOther, nil, nil)
+	return accepted
+}
+
