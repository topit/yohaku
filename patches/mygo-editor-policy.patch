--- a/ui/editor/policy_test.go
+++ b/ui/editor/policy_test.go
@@ -0,0 +1,109 @@
+package editor
+
+import (
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+)
+
+// A snapshot includes the state a rejection must not mutate. In particular,
+// nil changes must not be mistaken for an accepted no-op by editor.apply.
+type policyCheckpoint struct {
+	text            string
+	version         uint64
+	log, undo, redo int
+	sels            []Selection
+	marked          []ui.TextInputRange
+	active          bool
+}
+
+func checkpoint(st *State) policyCheckpoint {
+	b := st.Buffer
+	return policyCheckpoint{b.String(), b.Version(), len(b.log), len(b.undo), len(b.redo),
+		st.Selections(), slices.Clone(st.ed.marked), st.ed.markedActive}
+}
+
+func protectMark(b *Buffer) {
+	b.SetEditPolicy(func(s Snapshot, edits []Edit) bool {
+		start := strings.Index(s.String(), "MARK")
+		for _, e := range edits {
+			if e.Start < start+4 && e.End > start || e.Start == e.End && e.Start >= start && e.Start < start+4 {
+				return false
+			}
+		}
+		return true
+	})
+}
+
+func unchanged(t *testing.T, st *State, before policyCheckpoint) {
+	t.Helper()
+	if got := checkpoint(st); !reflect.DeepEqual(got, before) {
+		t.Fatalf("rejected edit mutated state:\n got %+v\nwant %+v", got, before)
+	}
+}
+
+func TestPolicyRejectsWholeBatchAndPreservesRedo(t *testing.T) {
+	ct := newEditorTest(t, "", "MARK\nbody|")
+	protectMark(ct.st.Buffer)
+	ct.st.Insert("!")
+	ct.st.Run(Undo)
+	ct.st.SetSelections(Selection{Anchor: 1, Head: 2}, Selection{Anchor: 6, Head: 7})
+	before := checkpoint(ct.st)
+	ct.st.Insert("中文😀")
+	unchanged(t, ct.st, before)
+	if ct.st.Buffer.TryEdit(Edit{Start: 1, End: 2}, Edit{Start: 6, End: 7}) {
+		t.Fatal("partial batch was accepted")
+	}
+	unchanged(t, ct.st, before)
+	ct.st.Buffer.Set("destroy all")
+	unchanged(t, ct.st, before)
+	ct.st.Run(Redo)
+	if ct.st.Buffer.String() != "MARK\nbody!" {
+		t.Fatal("rejected edit lost redo")
+	}
+}
+
+func TestPolicyIMERejectionPreservesMarkedText(t *testing.T) {
+	ct := newEditorTest(t, "", "MARK\n|body")
+	protectMark(ct.st.Buffer)
+	ct.st.Select(0, 4)
+	before := checkpoint(ct.st)
+	ct.st.ed.SetMarkedText(nil, "中", ui.TextInputRange{Start: 1, End: 1})
+	unchanged(t, ct.st, before)
+	ct.st.Select(5, 5)
+	ct.st.ed.SetMarkedText(nil, "中😀", ui.TextInputRange{Start: 3, End: 3})
+	if !ct.st.ed.markedActive || ct.st.Buffer.String() != "MARK\n中😀body" {
+		t.Fatal("valid composition failed")
+	}
+	before = checkpoint(ct.st)
+	r := &ui.TextInputRange{Start: 0, End: 4}
+	ct.st.ed.SetMarkedText(r, "bad", ui.TextInputRange{Start: 3, End: 3})
+	unchanged(t, ct.st, before)
+	ct.st.ed.ReplaceText(r, "bad commit")
+	unchanged(t, ct.st, before)
+	ct.st.ed.ReplaceText(nil, "中文😀")
+	if ct.st.ed.markedActive || ct.st.Buffer.String() != "MARK\n中文😀body" {
+		t.Fatal("valid commit failed")
+	}
+	ct.st.Run(Undo)
+	if ct.st.Buffer.String() != "MARK\nbody" {
+		t.Fatal("composition and commit did not undo as one step")
+	}
+}
+
+func TestPolicyFindReplaceRejectsWithoutAdvancing(t *testing.T) {
+	ct := newEditorTest(t, "", "|MARK\nbody MARK")
+	protectMark(ct.st.Buffer)
+	ct.st.Find("MARK")
+	ct.st.Select(0, 4)
+	f := &ct.st.ed.find
+	f.replace = "gone"
+	before := checkpoint(ct.st)
+	f.replaceOne(&ct.st.ed)
+	unchanged(t, ct.st, before)
+	f.replaceAll(&ct.st.ed)
+	unchanged(t, ct.st, before)
+}
