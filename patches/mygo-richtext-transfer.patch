--- /dev/null
+++ b/ui/richtext/transfer_policy_test.go
@@ -0,0 +1,44 @@
+package richtext
+
+import (
+	"github.com/egoist/mygo/ui"
+	"testing"
+)
+
+func TestPasteDelegateAndFailedCut(t *testing.T) {
+	d := NewDocument(NewText("before"))
+	reject := true
+	tt := ui.NewTester(func(c *ui.Context) {
+		EditorBase(c, d, EditorOptions{
+			OnCopy: func(Text) bool { return false },
+			OnPaste: func(bool) bool {
+				if !reject {
+					d.Edit(func(e *Edit) { a, z := e.Selection(); e.Replace(a, z, NewText("图😀")); e.Select(2, 2) })
+				}
+				return true
+			},
+		}).Fill().Focus()
+	}, 500, 300)
+	d.SetSelection(0, 6)
+	tt.Frame()
+	tt.Command("cut")
+	if d.Text().String() != "before" || d.CanUndo() {
+		t.Fatal("failed cut changed text/history")
+	}
+	tt.Command("paste")
+	a, c := d.Selection()
+	if d.Text().String() != "before" || a != 0 || c != 6 || d.CanUndo() {
+		t.Fatal("rejected paste changed selection/history")
+	}
+	reject = false
+	tt.Command("paste")
+	tt.Type("!")
+	if d.Text().String() != "图😀!" {
+		t.Fatal("delegate did not synchronize selection", d.Text().String())
+	}
+	d.Undo()
+	d.Undo()
+	if d.Text().String() != "before" {
+		t.Fatal("delegate paste broke undo")
+	}
+}
