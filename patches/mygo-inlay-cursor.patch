+package editor_test
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+	"github.com/egoist/mygo/ui/editor"
+)
+
+func TestTrailingInlayDoesNotMoveInsertionPoint(t *testing.T) {
+	for _, source := range []string{"4/", "结果 = 42", "\t12/3", "ab/cd"} {
+		t.Run(source, func(t *testing.T) {
+			st := &editor.State{Buffer: editor.NewBuffer(source), SoftWrap: true}
+			tt := ui.NewTester(func(c *ui.Context) { editor.View(c, st).Fill().AutoFocus() }, 220, 160)
+			at := len(source)
+			if source == "ab/cd" {
+				at = 3 // Also exercise a hint between two text segments.
+			}
+			st.Select(at, at)
+			tt.Frame()
+			before, ok := tt.TextCaret()
+			if !ok {
+				t.Fatal("missing focused insertion point")
+			}
+			st.SetInlays([]editor.Inlay{{Offset: at, Text: "   ! a long result that wraps over multiple rows", CursorBefore: true}})
+			tt.Frame()
+			after, ok := tt.TextCaret()
+			if !ok || after != before {
+				t.Fatalf("inlay displaced insertion point: before=%+v after=%+v", before, after)
+			}
+			tt.Type("7")
+			if st.Buffer.String() != source[:at]+"7"+source[at:] || st.Cursor() != at+1 {
+				t.Fatal("typing followed display text instead of source")
+			}
+			st.Run(editor.Undo)
+			if st.Buffer.String() != source || st.Cursor() != at {
+				t.Fatal("inlay changed source history")
+			}
+			st.Select(0, len(source))
+			tt.Key(ui.Cmd, ui.KeyC)
+			if tt.Clipboard() != source {
+				t.Fatal("copied display-only text")
+			}
+		})
+	}
+}
+
+func TestDefaultInlayKeepsExistingCaretPlacement(t *testing.T) {
+	st := &editor.State{Buffer: editor.NewBuffer("4/")}
+	tt := ui.NewTester(func(c *ui.Context) { editor.View(c, st).Fill().AutoFocus() }, 600, 160)
+	st.Select(2, 2)
+	tt.Frame()
+	before, _ := tt.TextCaret()
+	st.SetInlays([]editor.Inlay{{Offset: 2, Text: "   = 2"}})
+	tt.Frame()
+	after, _ := tt.TextCaret()
+	if after.X <= before.X || after.Y != before.Y {
+		t.Fatal("default hint behavior changed")
+	}
+}
