+++ b/ui/editor/divider_test.go
@@ -0,0 +1,115 @@
+package editor_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+	"github.com/egoist/mygo/ui/editor"
+)
+
+func TestDividerPresentationPreservesTextAndNavigation(t *testing.T) {
+	header := strings.Repeat("metadata-中文😀", 30)
+	text := header + "\nalpha中😀\nSECOND\nbeta"
+	st := &editor.State{Buffer: editor.NewBuffer(text), DividerLines: []string{header, "SECOND"},
+		LineNumbers: editor.LineNumbersOff, NoActiveLine: true, NoFolding: true, SoftWrap: true,
+		Theme: &editor.Theme{Background: ui.RGB(255, 255, 255)}}
+	tt := ui.NewTester(func(c *ui.Context) { editor.View(c, st).Fill().AutoFocus() }, 180, 200)
+	tt.Frame()
+	if st.LineTop(1) != st.LineTop(2)-st.LineTop(1) {
+		t.Fatal("a long divider wrapped instead of occupying one row")
+	}
+	img := tt.Image()
+	scale := float32(img.Bounds().Dx()) / 180
+	// No text is painted anywhere in the first divider, not merely hidden
+	// under another element. Its first row deliberately has no rule above it.
+	for y := 1; y < int((float32(st.LineTop(1))-1)*scale); y++ {
+		for x := int(8 * scale); x < int(170*scale); x++ {
+			p := img.RGBAAt(x, y)
+			if p.R < 250 || p.G < 250 || p.B < 250 {
+				t.Fatalf("divider leaked glyphs at %d,%d: %+v", x, y, p)
+			}
+		}
+	}
+	first, second := len(header)+1, strings.Index(text, "beta")
+	st.Run(editor.MoveDocStart)
+	if st.Cursor() != first {
+		t.Fatal("document start landed inside the leading divider")
+	}
+	st.Select(second, second)
+	st.Run(editor.MoveLeft)
+	if st.Cursor() != strings.Index(text, "\nSECOND") {
+		t.Fatal("left did not cross the entire divider atomically")
+	}
+	st.Run(editor.SelectRight)
+	if st.Selection().Head != second || st.SelectedText() != "\nSECOND\n" {
+		t.Fatalf("shift-right lost cross-divider selection: %+v %q", st.Selection(), st.SelectedText())
+	}
+	st.Select(first+2, first+2)
+	st.Run(editor.MoveDown)
+	if st.Cursor() != second+2 {
+		t.Fatal("down did not skip divider while retaining its column")
+	}
+	st.Run(editor.MoveUp)
+	if st.Cursor() != first+2 {
+		t.Fatal("up did not skip divider while retaining its column")
+	}
+	tt.ClickAt(100, float32((st.LineTop(2)+st.LineTop(3))/2))
+	if st.Cursor() != second {
+		t.Fatal("clicking a divider did not enter the following body")
+	}
+	st.Run(editor.SelectAll)
+	st.Run(editor.Copy)
+	if tt.Clipboard() != text {
+		t.Fatal("presentation changed the copied text")
+	}
+	st.Find("SECOND")
+	tt.Frame()
+	if count, _ := st.FindMatches(); count != 1 || st.SelectedText() != "SECOND" {
+		t.Fatal("find lost the underlying divider text")
+	}
+	tt.Key(0, ui.KeyEscape)
+	st.Select(first+2, first+2)
+	st.Insert("new\n")
+	tt.Frame()
+	st.Run(editor.Undo)
+	tt.Frame()
+	if st.Buffer.String() != text {
+		t.Fatal("undo did not restore text after a divider shifted")
+	}
+	st.DividerLines = nil
+	tt.Frame()
+	tt.Frame()
+	if st.LineTop(1) <= st.LineTop(2)-st.LineTop(1) {
+		t.Fatal("removing divider presentation did not restore wrapped text")
+	}
+}
+
+func TestCustomLineNumberCanHideStructuralLabel(t *testing.T) {
+	st := &editor.State{Buffer: editor.NewBuffer("body\nbody"), NoFolding: true, NoActiveLine: true,
+		LineNumber: func(line int) int {
+			if line == 0 {
+				return 7
+			}
+			return 0
+		},
+		Theme: &editor.Theme{Background: ui.RGB(255, 255, 255), Text: ui.RGB(0, 0, 0), LineNumber: ui.RGB(255, 0, 0), ActiveLineNumber: ui.RGB(255, 0, 0)}}
+	tt := ui.NewTester(func(c *ui.Context) { editor.View(c, st).Fill() }, 180, 100)
+	tt.Frame()
+	img := tt.Image()
+	scale := float32(img.Bounds().Dx()) / 180
+	red := [2]int{}
+	for line := range 2 {
+		for y := int(float32(st.LineTop(line)) * scale); y < int(float32(st.LineTop(line+1))*scale); y++ {
+			for x := 0; x < int(70*scale); x++ {
+				p := img.RGBAAt(x, y)
+				if int(p.R) > int(p.G)+40 && int(p.R) > int(p.B)+40 {
+					red[line]++
+				}
+			}
+		}
+	}
+	if red[0] == 0 || red[1] != 0 {
+		t.Fatalf("custom/hidden line labels not painted correctly: %v", red)
+	}
+}
