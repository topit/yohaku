@@ -0,0 +1,74 @@
+package editor
+
+import (
+	"slices"
+
+	"github.com/egoist/mygo/ui"
+)
+
+func (v *view) isDivider(line int) bool {
+	return len(v.dividers) > 0 && slices.Contains(v.dividers, v.text.Line(line))
+}
+
+// overDividers keeps navigation out of opaque text without changing the
+// actual selections used by find, copy or history replay.
+func (ed *editor) overDividers(from, to int) int {
+	v := &ed.view
+	forward := to >= from
+	for v.isDivider(v.text.LineOf(to)) {
+		line := v.text.LineOf(to)
+		if forward || line == 0 {
+			next := min(v.text.LineStart(line+1), v.text.Len())
+			if next == to {
+				break
+			}
+			to, forward = next, true
+		} else {
+			to = v.text.LineStart(line) - 1
+		}
+	}
+	return to
+}
+
+func (ed *editor) paintDivider(p *ui.Painter, r ui.Rect, f *frame, l *lineLayout, g lineGeometry) {
+	row := ui.Rect{X: r.X + ed.gutterW, Y: r.Y + float32(g.rows-ed.scrollY), W: r.W - ed.gutterW, H: ed.view.lineHeight}
+	for _, b := range ed.o.backgrounds {
+		if l.n >= b.First && l.n <= b.Last {
+			lower := row
+			if l.n > 0 {
+				lower.Y += row.H / 2
+				lower.H /= 2
+			}
+			p.Fill(lower, b.Color, 0)
+		}
+		if l.n > 0 && l.n-1 >= b.First && l.n-1 <= b.Last {
+			upper := row
+			upper.H /= 2
+			p.Fill(upper, b.Color, 0)
+		}
+	}
+	end := l.start + len(l.text)
+	for _, m := range f.matches {
+		if m.end > l.start && m.start <= end {
+			color := ed.theme.Match
+			if m == f.current {
+				color = ed.theme.CurrentMatch
+			}
+			p.Fill(row, color, 0)
+		}
+	}
+	for _, s := range ed.sels {
+		if !s.empty() && s.end() > l.start && s.start() <= end {
+			color := ed.theme.Selection
+			if !ed.focused {
+				color = ed.theme.InactiveSelection
+			}
+			p.Fill(row, color, 0)
+		}
+	}
+	if l.n > 0 {
+		row.Y += row.H / 2
+		row.H = 1
+		p.Fill(row, ed.theme.LineNumber.Alpha(0.3), 0)
+	}
+}
